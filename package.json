{
  "name": "scout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run start -w backend",
    "sync": "npm run sync -w backend --",
    "inspect": "npm run inspect -w backend --",
    "survey": "npm run survey -w backend --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @scout/frontend",
    "dev:api": "PORT=4000 npm run start -w @scout/backend",
    "extract": "npm run extract -w backend"
  }
}
